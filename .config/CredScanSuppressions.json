            texto += f"• {criterio}\n"

        texto += f"""
**Ponderación:**
"""
        for item, porcentaje in programa['evaluacion']['ponderacion'].items():
            texto += f"• {item}: {porcentaje}\n"

        texto += f"""

📖 **BIBLIOGRAFÍA**
==================
**Básica:**
"""
