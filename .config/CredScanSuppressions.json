    def _generar_cronograma(self, creditos: int) -> List[Dict]:
        """Genera cronograma tentativo"""
        semanas = creditos * 4  # Aproximadamente 4 semanas por crédito
        cronograma = []

        for semana in range(1, min(semanas + 1, 17)):  # Máximo 16 semanas
            cronograma.append({
                "semana": semana,
                "tema": f"Tema de la semana {semana}",
                "actividades": ["Lectura obligatoria", "Discusión en foro", "Actividad práctica"],
                "evaluacion": "Formativa" if semana % 2 == 0 else "Ninguna"
            })

        return cronograma

