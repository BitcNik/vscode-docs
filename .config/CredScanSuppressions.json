    def crear_rubrica_evaluacion(self, tipo_actividad: str = "ensayo_academico",
                               nivel: str = "licenciatura") -> Dict:
        """Crea una rúbrica de evaluación académica"""

        niveles_desempeno = {
            "excelente": {
                "descripcion": "Supera ampliamente los estándares esperados",
                "puntaje": "90-100"
            },
            "bueno": {
                "descripcion": "Cumple satisfactoriamente con los estándares",
                "puntaje": "80-89"
            },
            "satisfactorio": {
                "descripcion": "Cumple con los requisitos mínimos",
                "puntaje": "70-79"
            },
            "insuficiente": {
                "descripcion": "No cumple con los estándares requeridos",
                "puntaje": "0-69"
            }
        }

        criterios_rubrica = {
            "ensayo_academico": {
                "titulo": "Rúbrica para Ensayo Académico",
                "criterios": [
                    {
                        "nombre": "Claridad del argumento",
                        "descripcion": "Presentación lógica y coherente de la tesis",
                        "excelente": "Argumento impecable, bien estructurado y convincente",
                        "bueno": "Argumento claro y bien desarrollado",
                        "satisfactorio": "Argumento presente pero con algunas inconsistencias",
                        "insuficiente": "Argumento débil o ausente"
                    },
                    {
                        "nombre": "Uso de fuentes académicas",
                        "descripcion": "Incorporación crítica de literatura especializada",
                        "excelente": "Excelente selección y análisis crítico de fuentes",
                        "bueno": "Buen uso de fuentes relevantes y adecuadamente citadas",
                        "satisfactorio": "Uso básico de fuentes, algunas citaciones incompletas",
                        "insuficiente": "Fuentes inadecuadas o ausencia de citación"
                    },
                    {
                        "nombre": "Originalidad y pensamiento crítico",
                        "descripcion": "Contribución personal y análisis independiente",
                        "excelente": "Perspectiva original y análisis profundo",
                        "bueno": "Buen nivel de análisis y reflexión crítica",
                        "satisfactorio": "Análisis básico con algunas observaciones personales",
                        "insuficiente": "Falta de análisis crítico o pensamiento original"
                    }
                ]
            },
            "presentacion_oral": {
                "titulo": "Rúbrica para Presentación Oral Académica",
                "criterios": [
                    {
                        "nombre": "Organización y estructura",
                        "descripcion": "Claridad en la presentación de ideas",
                        "excelente": "Estructura impecable, fluidez y coherencia",
                        "bueno": "Buena organización y estructura lógica",
                        "satisfactorio": "Estructura aceptable con algunas inconsistencias",
                        "insuficiente": "Desorganizado o difícil de seguir"
                    },
                    {
                        "nombre": "Contenido y profundidad",
                        "descripcion": "Calidad y profundidad del contenido presentado",
                        "excelente": "Contenido excepcionalmente profundo y relevante",
                        "bueno": "Contenido sólido y bien fundamentado",
                        "satisfactorio": "Contenido básico pero adecuado",
                        "insuficiente": "Contenido superficial o irrelevante"
                    },
                    {
                        "nombre": "Dominio del tema",
                        "descripcion": "Conocimiento y seguridad en la exposición",
                        "excelente": "Dominio total del tema, responde con autoridad",
                        "bueno": "Buen conocimiento del tema, pocas dudas",
                        "satisfactorio": "Conocimiento básico, algunas dudas evidentes",
                        "insuficiente": "Falta de dominio del tema"
                    }
                ]
            }
        }

        rubrica_base = criterios_rubrica.get(tipo_actividad, criterios_rubrica["ensayo_academico"])

        rubrica = {
            "titulo": rubrica_base["titulo"],
            "tipo_actividad": tipo_actividad,
            "nivel_academico": nivel,
            "niveles_desempeno": niveles_desempeno,
            "criterios": rubrica_base["criterios"],
            "observaciones": "Esta rúbrica se aplica considerando los estándares académicos del nivel universitario"
        }

        return rubrica

    def formatear_rubrica(self, rubrica: Dict) -> str:
        """Formatea la rúbrica para mostrarla de forma clara"""
        texto = f"""📋 **{rubrica['titulo']}**

**Actividad:** {rubrica['tipo_actividad'].replace('_', ' ').title()}
**Nivel:** {rubrica['nivel_academico'].title()}

"""

        # Tabla de niveles de desempeño
        texto += "📊 **Niveles de Desempeño:**\n"
        for nivel, info in rubrica['niveles_desempeno'].items():
            texto += f"• **{nivel.title()}:** {info['descripcion']} ({info['puntaje']} pts)\n"

        texto += f"\n---\n\n"

        # Criterios de evaluación
        texto += "🎯 **Criterios de Evaluación:**\n\n"
        for criterio in rubrica['criterios']:
            texto += f"**{criterio['nombre']}**\n"
            texto += f"_{criterio['descripcion']}_\n\n"
            texto += "| Nivel | Descripción |\n"
            texto += "|-------|-------------|\n"
            texto += f"| Excelente | {criterio['excelente']} |\n"
            texto += f"| Bueno | {criterio['bueno']} |\n"
            texto += f"| Satisfactorio | {criterio['satisfactorio']} |\n"
            texto += f"| Insuficiente | {criterio['insuficiente']} |\n\n"

        texto += f"📝 {rubrica['observaciones']}"

        return texto

    def responder(self, mensaje: str) -> str:
        mensaje = mensaje.lower().strip()
        self.conversacion.append({"usuario": mensaje, "timestamp": datetime.now()})

        # Saludos
        if any(saludo in mensaje for saludo in ["hola", "buenos", "hello", "hi"]):
            return self.saludar()

        # Programa de asignatura
        elif "programa" in mensaje and ("asignatura" in mensaje or "materia" in mensaje):
            return """🎓 ¡Perfecto! Para crear un programa de asignatura necesito:

1. Nombre de la asignatura
2. Área de conocimiento
3. Número de créditos
4. Nivel académico (licenciatura/maestría/doctorado)
5. Modalidad (presencial/virtual/híbrida)

Ejemplo: 'Crea un programa de Inteligencia Artificial para Ingeniería de 4 créditos en licenciatura'"""

        # Generar programa específico
        elif "crear programa" in mensaje or ("programa" in mensaje and "de" in mensaje):
            # Extraer información del mensaje
            asignatura = self._extraer_asignatura_superior(mensaje)
            area = self._extraer_area(mensaje)
            creditos = self._extraer_creditos(mensaje)
            nivel = self._extraer_nivel_superior(mensaje)
            modalidad = self._extraer_modalidad(mensaje)

            if not asignatura:
                return "Por favor, especifica la asignatura. Ejemplo: 'Programa de Estadística Avanzada'"

            programa = self.crear_programa_asignatura(asignatura, creditos, area, nivel, modalidad)
            return self.formatear_programa(programa)

        # Rúbrica de evaluación
        elif "rúbrica" in mensaje or "rubrica" in mensaje or "evaluación" in mensaje:
            return """📋 ¿Qué tipo de rúbrica necesitas?

Puedo crear rúbricas para:
1. Ensayos académicos
2. Presentaciones orales
3. Proyectos de investigación
4. Participación en seminarios

Ejemplo: 'Hazme una rúbrica para ensayo académico de maestría'"""

        # Crear rúbrica específica
        elif "rubrica" in mensaje or "rúbrica" in mensaje:
            tipo = "ensayo_academico"
            nivel = "licenciatura"

            if "presentacion" in mensaje or "oral" in mensaje:
                tipo = "presentacion_oral"
            elif "proyecto" in mensaje:
                tipo = "proyecto_investigacion"

            if "maestría" in mensaje or "maestria" in mensaje:
                nivel = "maestría"
            elif "doctorado" in mensaje:
                nivel = "doctorado"

            rubrica = self.crear_rubrica_evaluacion(tipo, nivel)
            return self.formatear_rubrica(rubrica)

        # Configuración del usuario
        elif "soy" in mensaje:
            if "docente" in mensaje or "profesor" in mensaje:
                self.tipo_usuario = "docente"
            elif "estudiante" in mensaje:
                self.tipo_usuario = "estudiante"
            elif "investigador" in mensaje:
                self.tipo_usuario = "investigador"
            elif "coordinador" in mensaje or "director" in mensaje:
                self.tipo_usuario = "coordinador"
            return f"👋 ¡Bienvenido/a como {self.tipo_usuario} universitario/a! ¿En qué puedo ayudarte?"

        # Despedida
        elif any(despedida in mensaje for despedida in ["adiós", "chao", "gracias", "bye"]):
            return "🎓 ¡Hasta luego! Recuerda que estoy aquí para ayudarte con programas académicos, rúbricas y recursos pedagógicos universitarios. ¡Éxito en tu labor académica!"

        # Respuesta por defecto
        else:
            return """🤔 ¿En qué puedo ayudarte hoy en el ámbito de la Educación Superior?

Puedo:
✅ Crear programas completos de asignaturas
✅ Generar rúbricas de evaluación académica
✅ Diseñar contenidos curriculares universitarios
✅ Sugerir metodologías avanzadas de enseñanza
✅ Desarrollar sistemas de evaluación auténtica

Ejemplos:
• 'Crea un programa de Metodología de la Investigación de 3 créditos'
• 'Hazme una rúbrica para presentación oral de maestría'
• 'Genera un programa de Estadística para Psicología'"""

    def _extraer_asignatura_superior(self, mensaje: str) -> str:
        """Extrae la asignatura del mensaje"""
        # Palabras clave que NO son asignaturas
        ignorar = ["programa", "crear", "hacer", "generar", "sobre", "de", "la", "el", "en",
                  "para", "con", "créditos", "creditos", "licenciatura", "maestría", "doctorado",
                  "presencial", "virtual", "híbrida", "hibrida"]

        palabras = mensaje.split()
        asignatura_palabras = [palabra for palabra in palabras
                             if palabra.lower() not in ignorar and len(palabra) > 3]

        # Buscar asignaturas conocidas
        asignaturas_comunes = [
            "metodología", "metodologia", "estadística", "estadistica", "inteligencia artificial",
            "filosofía", "filosofia", "psicología", "psicologia", "sociología", "sociologia",
            "economía", "economia", "administración", "administracion", "derecho", "literatura",
            "química", "quimica", "física", "fisica", "matemáticas", "matematicas"
        ]

        for asignatura in asignaturas_comunes:
            if asignatura in mensaje:
                return asignatura.title()

        if asignatura_palabras:
            return " ".join(asignatura_palabras[:3]).title()
        return "Asignatura General"

    def _extraer_area(self, mensaje: str) -> str:
        """Extrae el área de conocimiento"""
        areas = {
            "ciencias_sociales": ["sociales", "sociología", "psicología", "antropología"],
            "ciencias_exactas": ["matemáticas", "física", "química", "estadística"],
            "humanidades": ["filosofía", "literatura", "historia", "arte"],
            "ciencias_de_la_salud": ["medicina", "enfermería", "psicología_clínica"],
            "ingeniería": ["ingeniería", "computación", "sistemas", "industrial"]
        }

        for area, palabras in areas.items():
            if any(palabra in mensaje for palabra in palabras):
                return area.replace("_", " ").title()

        return "Ciencias Sociales y Humanidades"

    def _extraer_creditos(self, mensaje: str) -> int:
        """Extrae el número de créditos"""
        import re
        numeros = re.findall(r'\d+', mensaje)
        for num in numeros:
            if 1 <= int(num) <= 10:  # Créditos típicos universitarios
                return int(num)
        return 3  # Por defecto

    def _extraer_nivel_superior(self, mensaje: str) -> str:
        """Extrae el nivel académico"""
        if "doctorado" in mensaje:
            return "doctorado"
        elif "maestría" in mensaje or "maestria" in mensaje:
            return "maestría"
        else:
            return "licenciatura"

    def _extraer_modalidad(self, mensaje: str) -> str:
        """Extrae la modalidad"""
        if "virtual" in mensaje:
            return "virtual"
        elif "híbrida" in mensaje or "hibrida" in mensaje:
            return "híbrida"
        else:
            return "presencial"

# Ejecutar el chatbot
def main():
    bot = ChatbotEduSuperior()
    print("🎓 Chatbot Pedagógico para Educación Superior")
    print("=" * 60)
    print(bot.saludar())

    while True:
        try:
            mensaje = input("\n👤 Tú: ")
            if mensaje.lower() in ['salir', 'exit', 'cerrar', 'fin']:
                print("🤖 Bot: ¡Adiós! 🎓")
                break

            respuesta = bot.responder(mensaje)
            print(f"\n🤖 Bot: {respuesta}")

        except KeyboardInterrupt:
            print("\n\n👋 ¡Hasta luego!")
            break
        except Exception as e:
            print(f"❌ Error: {e}")
            print("🤖 Bot: Lo siento, tuve un problema. ¿Puedes reformular tu pregunta?")

if __name__ == "__main__":
    main()
