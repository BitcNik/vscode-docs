    def crear_programa_asignatura(self, asignatura: str, creditos: int = 3, area: str = "",
                                nivel: str = "licenciatura", modalidad: str = "presencial") -> Dict:
        """Crea un programa completo de asignatura universitaria"""

        programa = {
            "identificacion": {
                "nombre_asignatura": asignatura,
                "codigo": self._generar_codigo(asignatura),
                "creditos": creditos,
                "area_conocimiento": area,
                "nivel_academico": nivel,
                "modalidad": modalidad,
                "periodo_academico": "2024-1",
                "fecha_elaboracion": datetime.now().strftime("%Y-%m-%d")
            },
            "descripcion": self._generar_descripcion(asignatura, area),
            "justificacion": self._generar_justificacion(asignatura, area, nivel),
            "objetivo_general": self._generar_objetivo_general(asignatura, area),
            "objetivos_especificos": self._generar_objetivos_especificos(asignatura, area),
            "competencias": self._definir_competencias(area),
            "contenido_tematico": self._estructurar_contenido(creditos),
            "metodologia": self._seleccionar_metodologia_avanzada(),
            "evaluacion": self._disenar_evaluacion_superior(),
            "bibliografia": self._generar_bibliografia(area),
            "recursos_didacticos": self._seleccionar_recursos_academicos(),
            "cronograma": self._generar_cronograma(creditos)
        }

        return programa

    def _generar_codigo(self, asignatura: str) -> str:
        """Genera un código para la asignatura"""
        palabras = asignatura.split()
        if len(palabras) >= 2:
            codigo = "".join([palabra[:2].upper() for palabra in palabras[:2]])
        else:
            codigo = asignatura[:4].upper()
        return f"{codigo}{random.randint(100, 999)}"

    def _generar_descripcion(self, asignatura: str, area: str) -> str:
        """Genera descripción de la asignatura"""
        return f"""Esta asignatura proporciona una introducción teórica y práctica al estudio de {asignatura}
dentro del campo de {area}. Se abordan los fundamentos conceptuales, metodológicos y aplicativos
que permiten al estudiante desarrollar una comprensión profunda de los principios y prácticas
contemporáneas en esta disciplina."""

    def _generar_justificacion(self, asignatura: str, area: str, nivel: str) -> str:
        """Genera justificación de la asignatura"""
        return f"""La asignatura {asignatura} responde a la necesidad de formar profesionales
competentes en {area} que puedan enfrentar los desafíos contemporáneos de su disciplina.
En el contexto del nivel {nivel}, esta materia proporciona las bases teóricas y metodológicas
necesarias para el desarrollo de competencias profesionales avanzadas y la formación de
investigadores capaces de contribuir al avance del conocimiento en su campo."""

    def _generar_objetivo_general(self, asignatura: str, area: str) -> str:
        """Genera objetivo general"""
        return f"""Desarrollar en los estudiantes una comprensión integral de los fundamentos
teóricos y metodológicos de {asignatura}, fomentando el pensamiento crítico, la capacidad
de análisis y la aplicación práctica de conocimientos en contextos reales de {area}."""

    def _generar_objetivos_especificos(self, asignatura: str, area: str) -> List[str]:
        """Genera objetivos específicos"""
        return [
            f"Analizar críticamente los principales enfoques teóricos en {asignatura}",
            f"Aplicar metodologías apropiadas para la investigación en {area}",
            f"Evaluar críticamente fuentes académicas especializadas en {asignatura}",
            f"Desarrollar proyectos académicos que integren teoría y práctica en {area}",
            f"Comunicar efectivamente hallazgos académicos en formatos profesionales"
        ]

    def _definir_competencias(self, area: str) -> Dict:
        """Define competencias del programa"""
        competencias_genericas = random.sample(self.competencias_genericas, 4)

        # Seleccionar competencias específicas según el área
        area_key = area.lower().replace(" ", "_")
        if area_key in self.competencias_especificas:
            competencias_especificas = self.competencias_especificas[area_key]
        else:
            competencias_especificas = random.sample(
                list(self.competencias_especificas.values())[0], 3
            )

        return {
            "genericas": competencias_genericas,
            "especificas": competencias_especificas[:3]
        }

